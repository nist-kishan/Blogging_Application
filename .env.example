# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================
# Options: dev, test, prod
NODE_ENV=development

# ==========================================
# BACKEND CONFIGURATIONS (Spring Boot 4.0)
# ==========================================

# Server Port Configuration
PORT=8080

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/blog_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword123
DATABASE_DRIVER=org.postgresql.Driver

# ==========================================
# JWT SECURITY CONFIGURATION
# ==========================================
# JWT Secret Key (minimum 256-bit / 32 characters - MUST be changed in production)
JWT_SECRET=ProductionGradeSecretKeyForJWTTokenSigningDoNotExposeOrLeakMustBeLongerThan32Bytes

# Access Token Expiration (milliseconds: 900000 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Refresh Token Expiration (milliseconds: 604800000 = 7 days)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ==========================================
# COOKIE CONFIGURATION
# ==========================================
# Set to true for HTTPS environments (production)
COOKIE_SECURE=false

# Options: Strict, Lax, None
COOKIE_SAME_SITE=Lax

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
# Gmail Configuration (or use your email service provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
# Use App-specific password for Gmail (not regular password)
SMTP_PASSWORD=your_app_password

# Enable/Disable email sending (true/false)
MAIL_ENABLED=true

# ==========================================
# CLOUDINARY CONFIGURATION (Image Upload)
# ==========================================
# Sign up at https://cloudinary.com to get credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# Frontend Base URL (used for email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# ==========================================
# FRONTEND CONFIGURATIONS (React.js + Vite)
# ==========================================

# Backend API Base URL
VITE_API_URL=http://localhost:8080

# Frontend Environment Mode (development, production)
VITE_ENV=development

# ==========================================
# LOGGING CONFIGURATION (Optional)
# ==========================================
# Log Level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
SPRING_LOG_LEVEL_ROOT=INFO
SPRING_LOG_LEVEL_BLOGPLATFORM=DEBUG
SPRING_LOG_LEVEL_SECURITY=INFO

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
# Maximum file size for uploads (default: 10MB)
FILE_MAX_SIZE=10485760

# Maximum request size (default: 10MB)
REQUEST_MAX_SIZE=10485760
