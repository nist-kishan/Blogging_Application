# ==========================================
# BACKEND CONFIGURATIONS (Spring Boot)
# ==========================================
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/blog_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword123

# Security Configuration (JWT key minimum 256-bit, at least 32 characters)
JWT_SECRET=ProductionGradeSecretKeyForJWTTokenSigningDoNotExposeOrLeakMustBeLongerThan32Bytes

# SMTP Mail Server Configuration (Gmail fallback logged in console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password

# ==========================================
# FRONTEND CONFIGURATIONS (React.js + Vite)
# ==========================================
# Base URL pointing to the Spring Boot REST API
VITE_API_URL=http://localhost:8085
